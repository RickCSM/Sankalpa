# Dependencies (reinstalled inside the image)
**/node_modules

# Build output (rebuilt inside the image)
**/dist
**/.tsbuildinfo
*.tsbuildinfo
**/out-tsc

# Local agent / editor / cache state
.local
.cache
.git
.idea
.vscode

# Large data artifacts — imported at runtime, never needed at build time
*.tar.gz
*.sql
*.sql.gz
*.docx

# Server-only secrets & data (must never enter an image)
.env
.env.*
!.env.example
certs
uploads
