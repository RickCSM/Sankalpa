# Copy to .env on your server. Never commit the real .env.
NODE_ENV=production
PORT=5000
# Provision this database/user first. URL-encode special characters in credentials.
DATABASE_URL=postgresql://sankalpa:CHANGE_ME@127.0.0.1:5432/sankalpa
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
SESSION_IDLE_HOURS=8
PUBLIC_API_URL=https://sankalpa.example.com
ALLOWED_ORIGINS=https://sankalpa.example.com
STORAGE_BACKEND=local
UPLOAD_DIR=/var/lib/sankalpa/uploads
LOG_LEVEL=info