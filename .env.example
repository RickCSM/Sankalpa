# =============================================================================
# Sankalpa Odisha — environment template.
#
#   1. Copy this file to .env            (./deploy/gen-secrets.sh does this)
#   2. Let gen-secrets.sh fill the CHANGE_ME secrets automatically
#   3. Set PUBLIC_API_URL / ALLOWED_ORIGINS to YOUR domain
#
# The real .env is NEVER committed to git. Only this template is.
# =============================================================================

# ---- Database (Postgres container) ----
POSTGRES_USER=sankalpa
POSTGRES_DB=sankalpa
# Auto-generated by ./deploy/gen-secrets.sh — do not set by hand in production.
POSTGRES_PASSWORD=CHANGE_ME_RUN_GEN_SECRETS

# ---- API server ----
# Must be >= 16 characters. Auto-generated by ./deploy/gen-secrets.sh.
SESSION_SECRET=CHANGE_ME_RUN_GEN_SECRETS
# Idle session expiry in hours (1-168). Optional; defaults to 8.
SESSION_IDLE_HOURS=8
# Log verbosity: trace|debug|info|warn|error. Optional; defaults to info.
LOG_LEVEL=info

# ---- Public URLs — set these to your real domain ----
# Used to build absolute file-upload URLs and the CORS allowlist.
# Must be the https:// origin the browser actually uses.
PUBLIC_API_URL=https://sankalpa.odisha.gov.in
ALLOWED_ORIGINS=https://sankalpa.odisha.gov.in

# ---- Host ports the web (nginx) container binds to ----
HTTP_PORT=80
HTTPS_PORT=443
